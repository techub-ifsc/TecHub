# Copie para .env e preencha os valores privados.
# Nunca coloque credenciais reais neste arquivo de exemplo.

NODE_ENV=production
PORT=3001

DB_DIALECT=postgres
DB_HOST=SEU_HOST_NEON
DB_PORT=5432
DB_NAME=neondb
DB_USER=SEU_USUARIO_NEON
DB_PASSWORD="SUA_SENHA_DO_BANCO"

DB_SSL=true
DB_SSL_CA_FILE=

JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO
JWT_EXPIRES_IN=1d

# Regra temporária para cadastro de criadores. Separe os domínios por vírgula.
CREATOR_ALLOWED_DOMAINS=@ifsc.edu.br,@aluno.ifsc.edu.br

# Usadas somente pelo comando npm run admin:create. Não versionar valores reais.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Prazo, em dias, que a moderação tem para analisar um projeto enviado (padrão: 3).
MODERATION_SLA_DAYS=3

FRONTEND_URL=http://localhost:5173

# Confirmação de e-mail: provedor SMTP definido pela equipe. Não versionar credenciais.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TecHub <no-reply@seudominio.com>"
# Página do frontend que lê ?token=... e chama POST /api/auth/verify-email.
# Em desenvolvimento pode ser http://localhost:5173/verify-email; em produção, HTTPS é obrigatório.
EMAIL_VERIFICATION_URL=https://seu-front.example/verify-email
# Página do frontend que lê ?token=... e envia token, password e confirmPassword
# a POST /api/auth/reset-password. Em produção, HTTPS é obrigatório.
PASSWORD_RESET_URL=https://seu-front.example/reset-password

# Storage das fotos e vídeos dos projetos (Cloudinary → Settings → API Keys).
# Sem estas três variáveis o POST /api/media/upload responde 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
